NODE_ENV=production
PORT=3000
# Generate a long random secret; never commit real credentials.
SESSION_SECRET=replace-with-at-least-32-random-characters
# For a small install, leave DATABASE_URL blank to use SQLite in ./data.
# For PostgreSQL, set DATABASE_URL=postgres://user:password@host:5432/kd_hologram
DATABASE_URL=
PGSSL=
DATA_DIR=./data
# Bootstrap an initial admin on first startup. Use a strong unique password (12+ chars).
ADMIN_NAME=KD Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Public registration is disabled unless explicitly enabled.
ALLOW_SIGNUP=false
# OpenAI-compatible provider (keys stay on server).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional JSON array describing preconfigured MCP tools for the UI; execution is not enabled by this starter.
MCP_TOOLS_JSON=[]
